# Serveur
HOST=0.0.0.0
PORT=3000
DATABASE_PATH=/var/lib/last-loop/backyard.sqlite
# true pour charger la course de démonstration dans une base vide
SEED_DEMO_DATA=false

# URL publique utilisée dans les e-mails (sans slash final, HTTPS en production)
APP_URL=https://backyard.example.com

# SMTP — utiliser SMTP_URL ou les variables détaillées ci-dessous
# SMTP_URL=smtps://user:password@smtp.example.com:465
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=backyard@example.com
SMTP_PASSWORD=change-me
MAIL_FROM=Last Loop <no-reply@example.com>
# Développement uniquement : renvoie le lien à la direction sans envoyer d'e-mail
MAIL_PREVIEW=false

# Fournisseur de tuiles OSM configurable. Les valeurs ci-dessous utilisent
# le serveur communautaire standard et nécessitent de respecter sa politique.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href=https://www.openstreetmap.org/copyright>OpenStreetMap</a> contributors

# Durée de conservation des points GPS en base (entre 1 et 90 jours)
GPS_RETENTION_DAYS=14
# Écart au tracé déclenchant l'indicateur « hors parcours » (50 à 2000 m)
GPS_OFF_ROUTE_THRESHOLD_M=200
